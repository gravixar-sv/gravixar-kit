{
  "name": "@gravixar/forms",
  "version": "0.1.0",
  "description": "Public form submissions for server actions: a bot gate that runs before validation, any Standard Schema validator, stable ids for dedupe, and delivery steps that fail closed in production.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p test/tsconfig.json",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravixar-sv/gravixar-kit.git",
    "directory": "packages/forms"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "resend": "^6.30.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  }
}
